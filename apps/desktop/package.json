{
  "name": "@inkshadow/desktop",
  "version": "0.2.14",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:web",
    "build:workspace-dependencies": "pnpm --filter \"@inkshadow/desktop...\" --filter \"!@inkshadow/desktop\" --if-present build",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build --configLoader runner",
    "build:web:release": "pnpm build:workspace-dependencies && node ../../scripts/capture-desktop-release-source.mjs --output apps/desktop/.tmp/release-source-baseline.json && tsc --noEmit -p tsconfig.json && vite build --configLoader runner --outDir dist-release --emptyOutDir && node ../../scripts/write-desktop-release-manifest.mjs --dist apps/desktop/dist-release --source-baseline apps/desktop/.tmp/release-source-baseline.json",
    "dev": "vite --port 1420 --strictPort --configLoader runner",
    "dev:vite": "vite --port 1420 --strictPort --configLoader runner",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "pnpm build:web:release && tauri build --config src-tauri/tauri.release-gate.conf.json --ci",
    "tauri:build:unsigned": "pnpm build:web:release && tauri build --config src-tauri/tauri.release-gate.conf.json --ci --no-sign",
    "tauri:package:unsigned:prebuilt": "tauri build --config src-tauri/tauri.release-gate.conf.json --ci --no-sign",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@inkshadow/ai-core": "workspace:*",
    "@inkshadow/application": "workspace:*",
    "@inkshadow/cloud-client": "workspace:*",
    "@inkshadow/config": "workspace:*",
    "@inkshadow/contracts": "workspace:*",
    "@inkshadow/data": "workspace:*",
    "@inkshadow/domain": "workspace:*",
    "@inkshadow/import-export": "workspace:*",
    "@inkshadow/observability": "workspace:*",
    "@inkshadow/platform": "workspace:*",
    "@inkshadow/search-core": "workspace:*",
    "@inkshadow/story-core": "workspace:*",
    "@inkshadow/sync-core": "workspace:*",
    "@inkshadow/task-engine": "workspace:*",
    "@inkshadow/ui": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "terser": "5.49.2",
    "vite": "^7.0.0"
  }
}
