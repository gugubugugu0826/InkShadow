# InkShadow runtime defaults. Never place API keys or database passwords here.
INKSHADOW_APP_ENV=development
INKSHADOW_LOG_LEVEL=info
INKSHADOW_TELEMETRY_ENABLED=false
INKSHADOW_UPDATE_CHANNEL=stable
# Desktop release-build trust anchors. Both are public build inputs, but must
# only be supplied by the authorized release pipeline. The Ed25519 private key
# and Windows code-signing credential must never be placed in this file.
# INKSHADOW_UPDATE_MANIFEST_URL=https://updates.example.invalid/v1/stable.json
# INKSHADOW_UPDATE_PUBLIC_KEY_B64URL=<canonical-32-byte-ed25519-public-key>

# Optional cloud sync endpoint. HTTPS is required except for loopback development.
# INKSHADOW_SYNC_API_URL=https://sync.example.invalid
# Desktop build-time cloud endpoint. This value is public and must never contain
# credentials. Cloud identity and sync feature flags remain disabled by default.
# VITE_INKSHADOW_CLOUD_API_BASE_URL=https://cloud.example.invalid
# VITE_INKSHADOW_CLOUD_IDENTITY_ENABLED=false
# VITE_INKSHADOW_CLOUD_SYNC_ENABLED=false
# VITE_INKSHADOW_TEAM_COLLABORATION_ENABLED=false
# Local-only multi-Agent review. Disabled by default; enabling this does not
# enable team-cloud execution or bypass model-route and pricing preflight.
# VITE_INKSHADOW_MULTI_AGENT_ENABLED=false
# Local-only fine-tuning governance. Disabled by default. Enabling it does not
# configure a trainer or permit remote training; without an audited local
# trainer, only rights/privacy/quota/approval preparation is available.
# VITE_INKSHADOW_FINE_TUNING_ENABLED=false
# Governed translation and short-drama workspaces. Both remain disabled unless
# the user has configured an audited provider and explicitly accepts the
# one-time plaintext egress disclosure for each remote destination.
# VITE_INKSHADOW_TRANSLATION_ENABLED=false
# VITE_INKSHADOW_SHORT_DRAMA_ENABLED=false
# VITE_INKSHADOW_COMMUNITY_MARKETPLACE_ENABLED=false
# Cloud community marketplace service. Both server and desktop switches default
# off. The cursor key must be an independently generated 32-64 byte base64url
# secret and is required only when the server switch is enabled.
# INKSHADOW_COMMUNITY_MARKETPLACE_ENABLED=false
# INKSHADOW_MARKETPLACE_CURSOR_KEY=<independent-base64url-secret>
# Local authoritative Story graph projection. Disabled until explicitly enabled.
# VITE_INKSHADOW_GRAPH_RAG_ENABLED=false
# Candidate-only authoritative extraction. Requires GraphRAG plus a configured
# validation model route with immutable pricing/context metadata. Remote routes
# also require a keyring credential; no provider is inferred or simulated.
# VITE_INKSHADOW_AUTHORITATIVE_EXTRACTION_ENABLED=false
# Debug loopback builds only:
# VITE_INKSHADOW_CLOUD_ALLOW_INSECURE_LOOPBACK=false

# Cloud API deployment (server-side only). Keep every secret independently generated
# and inject it through the deployment secret manager; never commit populated values.
# Production uses an explicit `--migrate-only` init process with two database
# identities on the exact same PostgreSQL protocol/host/port/database/TLS
# target. Only that process receives the migration URL. The long-lived API
# receives the runtime URL and the two non-secret role names, but never the
# migration URL/password. Production accepts only sslmode=verify-full and an
# unencoded lowercase database name. Role names are strict lowercase
# PostgreSQL identifiers and must match the corresponding URL user.
# INKSHADOW_CLOUD_DATABASE_URL=postgresql://inkshadow_runtime:<runtime-password>@db.example/inkshadow?sslmode=verify-full
# INKSHADOW_CLOUD_RUNTIME_DATABASE_ROLE=inkshadow_runtime
# INKSHADOW_CLOUD_MIGRATION_DATABASE_URL=postgresql://inkshadow_migration:<migration-password>@db.example/inkshadow?sslmode=verify-full
# INKSHADOW_CLOUD_MIGRATION_DATABASE_ROLE=inkshadow_migration
# Optional outside the Enterprise manifest, which mounts it by default. Must
# be a normalized absolute path to a <=64 KiB PEM bundle containing only
# certificates. When absent, Node's protected system CA store is used.
# INKSHADOW_CLOUD_DATABASE_CA_FILE=/run/inkshadow-database-ca/ca.pem
# INKSHADOW_CLOUD_HOST=127.0.0.1
# INKSHADOW_CLOUD_PORT=8787
# INKSHADOW_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
# INKSHADOW_MINIMUM_CLIENT_VERSION=0.1.0
# INKSHADOW_CHALLENGE_DELIVERY_URL=https://<mail-service-host>/v1/deliver
# INKSHADOW_CHALLENGE_DELIVERY_TOKEN=<mail-service-bearer-token>
# Optional Studio invitation delivery. When absent, invitation creation fails
# closed while the rest of the cloud API remains available.
# INKSHADOW_TEAM_INVITATION_DELIVERY_URL=https://<mail-service-host>/v1/deliver
# INKSHADOW_TEAM_INVITATION_DELIVERY_TOKEN=<independent-mail-service-bearer-token>
# INKSHADOW_TEAM_INVITATION_OUTBOX_KEY=<independent-32-byte-base64url-aes-key>
# INKSHADOW_TEAM_INVITATION_OUTBOX_KEY_ID=team-invitations-v1
# INKSHADOW_TEAM_INVITATION_OUTBOX_PREVIOUS_KEYS_JSON=[{"keyId":"team-invitations-v0","key":"<previous-32-byte-base64url-aes-key>"}]
# INKSHADOW_CHALLENGE_CODE_KEY=<independent-32-byte-base64url-secret>
# INKSHADOW_CHALLENGE_HASH_KEY=<independent-32-byte-base64url-secret>
# INKSHADOW_SESSION_TOKEN_KEY=<independent-32-byte-base64url-secret>
# INKSHADOW_PAGE_CURSOR_KEY=<independent-32-byte-base64url-secret>
# INKSHADOW_SYNC_CURSOR_KEY=<independent-32-byte-base64url-secret>
# Private Enterprise deployment. A private process refuses startup unless the
# Ed25519-signed, deployment-bound offline license is present and currently valid.
# Keep the license, OIDC configuration and every secret in the deployment secret
# manager. OIDC client secrets are referenced by environment-variable name so
# they never appear inside the provider configuration JSON.
# INKSHADOW_DEPLOYMENT_MODE=private
# INKSHADOW_ENTERPRISE_DEPLOYMENT_ID=<stable-private-deployment-id>
# INKSHADOW_ENTERPRISE_LICENSE_PUBLIC_KEY=<ed25519-spki-der-base64url>
# INKSHADOW_ENTERPRISE_LICENSE_JSON={"payload":{"schemaVersion":1,"product":"inkshadow","licenseId":"<id>","keyId":"<key-id>","deploymentId":"<matching-deployment-id>","tier":"enterprise","issuedAt":"<iso-utc>","notBefore":"<iso-utc>","validUntil":"<iso-utc>","capabilities":["enterprise.policy","enterprise.private_deployment","enterprise.sso"],"licensedTeamIds":["<uuidv7-team-id>"]},"signature":"<ed25519-signature-base64url>"}
# INKSHADOW_ENTERPRISE_OIDC_FLOW_KEY=<independent-32-byte-base64url-secret>
# INKSHADOW_ENTERPRISE_OIDC_METADATA_CACHE_SECONDS=300
# INKSHADOW_ENTERPRISE_OIDC_FLOW_LIFETIME_SECONDS=600
# INKSHADOW_ENTERPRISE_OIDC_PROVIDERS_JSON=[{"teamId":"<licensed-uuidv7-team-id>","issuer":"https://idp.example.invalid/","clientId":"<client-id>","clientSecretEnvironment":"INKSHADOW_OIDC_CLIENT_SECRET_PRIMARY","redirectUris":["inkshadow://enterprise/sso/callback"]}]
# INKSHADOW_OIDC_CLIENT_SECRET_PRIMARY=<oidc-client-secret>
# Required in private mode. Protects the cluster-internal Prometheus endpoint.
# INKSHADOW_METRICS_BEARER_TOKEN=<independent-random-bearer-token-at-least-32-characters>
# Offline Enterprise recovery tooling only; do not inject these into the API pod.
# Logical backups require a dedicated NOSUPERUSER, BYPASSRLS role that has SELECT
# but no write privileges, an age X25519 recipient and a mode-0400/0600 Ed25519
# signing private key. Restore uses a protected libpq service definition so the
# database credential never appears in process arguments.
# INKSHADOW_BACKUP_DATABASE_URL=postgresql://<read-only-backup-user>:<password>@db.example/inkshadow?sslmode=verify-full
# INKSHADOW_BACKUP_OUTPUT_DIR=/protected/inkshadow-backups
# INKSHADOW_BACKUP_AGE_RECIPIENT=age1<canonical-x25519-recipient>
# INKSHADOW_BACKUP_SIGNING_PRIVATE_KEY_FILE=/run/secrets/inkshadow-backup-ed25519.pem
# INKSHADOW_BACKUP_PROMETHEUS_TEXTFILE=/var/lib/node_exporter/textfile_collector/inkshadow-backup.prom
# PGSERVICEFILE=/run/secrets/inkshadow-pg-service.conf
# INKSHADOW_RESTORE_DATABASE_SERVICE=inkshadow_isolated_restore
# INKSHADOW_RESTORE_EXPECTED_DATABASE_NAME=inkshadow_restore_2026q3
# INKSHADOW_RESTORE_BACKUP_PATH=/protected/inkshadow-backups/<backup>.dump.age
# INKSHADOW_RESTORE_AGE_IDENTITY_FILE=/run/secrets/inkshadow-backup-age-identity.txt
# INKSHADOW_RESTORE_SIGNING_PUBLIC_KEY_FILE=/run/config/inkshadow-backup-ed25519.pub.pem
# INKSHADOW_RESTORE_CONFIRM=RESTORE_TO_ISOLATED_TARGET
# INKSHADOW_RESTORE_PROMETHEUS_TEXTFILE=/var/lib/node_exporter/textfile_collector/inkshadow-restore.prom
# Bounded maintenance defaults: every 300 seconds, 250 rows per batch, at most
# eight full batches per target. Retention values may be raised within the
# server-enforced bounds, but never below the documented security minimums.
# INKSHADOW_CLOUD_MAINTENANCE_INTERVAL_SECONDS=300
# INKSHADOW_CLOUD_MAINTENANCE_BATCH_SIZE=250
# INKSHADOW_CLOUD_MAINTENANCE_MAX_BATCHES_PER_TARGET=8
# INKSHADOW_CLOUD_CHALLENGE_RETENTION_DAYS=7
# INKSHADOW_CLOUD_IDEMPOTENCY_GRACE_HOURS=24
# INKSHADOW_CLOUD_SESSION_RETENTION_DAYS=30
# INKSHADOW_CLOUD_SYNC_BATCH_RETENTION_DAYS=30
# INKSHADOW_CLOUD_TOMBSTONE_ACK_GRACE_DAYS=30
# INKSHADOW_CLOUD_DELETION_GRACE_DAYS=30
# INKSHADOW_CLOUD_DELETION_BACKUP_RETENTION_DAYS=30
# INKSHADOW_CLOUD_DELETION_INTERVAL_SECONDS=30
# INKSHADOW_CLOUD_DELETION_BATCH_SIZE=250
# INKSHADOW_CLOUD_DELETION_TENANTS_PER_RUN=32
# INKSHADOW_CLOUD_DELETION_LEASE_SECONDS=30
# INKSHADOW_CLOUD_DELETION_RETRY_SECONDS=60
# INKSHADOW_CLOUD_DELETION_BLOCKED_RECHECK_SECONDS=300
# INKSHADOW_CLOUD_DELETION_WORKER_ID=cloud-api-blue-1
# Loopback development only:
# INKSHADOW_ALLOW_INSECURE_LOCAL_HTTP=true
# INKSHADOW_ALLOW_INSECURE_LOCAL_DATABASE=true

# Local helper/model discovery binds to loopback only.
INKSHADOW_LOCAL_SERVICE_HOST=127.0.0.1
INKSHADOW_LOCAL_SERVICE_PORT=32787
