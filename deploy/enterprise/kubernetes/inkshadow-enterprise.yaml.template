apiVersion: v1
kind: ServiceAccount
metadata:
  name: inkshadow-cloud-api
  namespace: __NAMESPACE__
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: inkshadow-cloud-api
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: inkshadow-cloud-api
spec:
  replicas: __REPLICAS__
  minReadySeconds: 10
  progressDeadlineSeconds: 600
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: inkshadow-cloud-api
  template:
    metadata:
      labels:
        app.kubernetes.io/name: inkshadow-cloud-api
    spec:
      serviceAccountName: inkshadow-cloud-api
      automountServiceAccountToken: false
      enableServiceLinks: false
      hostIPC: false
      hostNetwork: false
      hostPID: false
      terminationGracePeriodSeconds: 45
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: DoNotSchedule
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: inkshadow-cloud-api
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: inkshadow-cloud-api
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: database-migrations
          image: __IMAGE__
          imagePullPolicy: IfNotPresent
          args:
            - --migrate-only
          env:
            - name: INKSHADOW_APP_ENV
              value: production
            - name: INKSHADOW_CLOUD_RUNTIME_DATABASE_ROLE
              value: inkshadow_runtime
            - name: INKSHADOW_CLOUD_MIGRATION_DATABASE_ROLE
              value: inkshadow_migration
            - name: INKSHADOW_CLOUD_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: inkshadow-enterprise-runtime-secrets
                  key: INKSHADOW_CLOUD_DATABASE_URL
            - name: INKSHADOW_CLOUD_MIGRATION_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: inkshadow-enterprise-migration-secrets
                  key: INKSHADOW_CLOUD_MIGRATION_DATABASE_URL
            - name: INKSHADOW_CLOUD_DATABASE_CA_FILE
              value: /run/inkshadow-database-ca/ca.pem
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            privileged: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
          volumeMounts:
            - name: database-ca
              mountPath: /run/inkshadow-database-ca
              readOnly: true
      containers:
        - name: api
          image: __IMAGE__
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8787
              protocol: TCP
          env:
            - name: INKSHADOW_APP_ENV
              value: production
            - name: INKSHADOW_DEPLOYMENT_MODE
              value: private
            - name: INKSHADOW_CLOUD_RUNTIME_DATABASE_ROLE
              value: inkshadow_runtime
            - name: INKSHADOW_CLOUD_MIGRATION_DATABASE_ROLE
              value: inkshadow_migration
            - name: INKSHADOW_CLOUD_DATABASE_CA_FILE
              value: /run/inkshadow-database-ca/ca.pem
            - name: INKSHADOW_CLOUD_HOST
              value: 0.0.0.0
            - name: INKSHADOW_CLOUD_PORT
              value: "8787"
            - name: INKSHADOW_TRUSTED_PROXY_ADDRESSES
              value: __TRUSTED_PROXY_CIDRS__
          envFrom:
            - secretRef:
                name: inkshadow-enterprise-runtime-secrets
          readinessProbe:
            httpGet:
              path: /health/ready
              port: http
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health/live
              port: http
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          startupProbe:
            httpGet:
              path: /health/live
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 24
          resources:
            requests:
              cpu: __CPU_REQUEST__
              memory: __MEMORY_REQUEST__
            limits:
              cpu: __CPU_LIMIT__
              memory: __MEMORY_LIMIT__
          securityContext:
            allowPrivilegeEscalation: false
            privileged: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: database-ca
              mountPath: /run/inkshadow-database-ca
              readOnly: true
      volumes:
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
        - name: database-ca
          secret:
            secretName: inkshadow-enterprise-database-ca
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: inkshadow-cloud-api
  namespace: __NAMESPACE__
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: inkshadow-cloud-api
  ports:
    - name: http
      port: 8787
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: inkshadow-cloud-api
  namespace: __NAMESPACE__
spec:
  tls:
    - hosts:
        - __PUBLIC_HOST__
      secretName: __TLS_SECRET__
  rules:
    - host: __PUBLIC_HOST__
      http:
        paths:
          - path: /v1
            pathType: Prefix
            backend:
              service:
                name: inkshadow-cloud-api
                port:
                  name: http
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: inkshadow-cloud-api
  namespace: __NAMESPACE__
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: inkshadow-cloud-api
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: inkshadow-cloud-api
  namespace: __NAMESPACE__
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: inkshadow-cloud-api
  minReplicas: __REPLICAS__
  maxReplicas: __MAX_REPLICAS__
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: inkshadow-cloud-api
  namespace: __NAMESPACE__
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: inkshadow-cloud-api
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: __INGRESS_NAMESPACE__
      ports:
        - protocol: TCP
          port: 8787
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: __MONITORING_NAMESPACE__
      ports:
        - protocol: TCP
          port: 8787
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
__EGRESS_RULES__
