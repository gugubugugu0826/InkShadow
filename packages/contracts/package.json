{
  "name": "@inkshadow/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./states": {
      "types": "./src/states.ts",
      "default": "./src/states.ts"
    },
    "./marketplace": {
      "types": "./src/marketplace-api-schemas.ts",
      "default": "./src/marketplace-api-schemas.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
