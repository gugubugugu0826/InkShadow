{
  "name": "@inkshadow/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@inkshadow/contracts": "workspace:*",
    "@inkshadow/domain": "workspace:*",
    "@inkshadow/search-core": "workspace:*",
    "@inkshadow/story-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
